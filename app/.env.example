# Copia este archivo como .env.local y pon los datos del proyecto de Supabase
# (Project Settings → API). La clave publicable está hecha para ir en el navegador;
# la clave secreta (service_role o sb_secret_...) nunca va aquí.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
